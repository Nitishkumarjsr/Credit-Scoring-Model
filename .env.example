# =========================================================================
# CrediPulse AI: Environment Configuration
# =========================================================================

# Flask Server Port (Default: 5001 locally, Render auto-sets PORT)
PORT=5001

# Supabase PostgreSQL Integration (Optional - falls back to local memory if unset)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Frontend URL (For backend API CORS whitelist)
FRONTEND_URL=https://your-credit-score-app.vercel.app
